# Environment variables for getupp-website.
# Copy relevant values into .env.local (gitignored) for local development.

# --- Vercel ---
# VERCEL_OIDC_TOKEN is generated automatically by the Vercel CLI when the
# project is linked (`vercel link`) or via `vercel env pull`. No action needed.

# --- Supabase (getupp-website project) ---
# Public URL and publishable/anon key for the Getupp website's own Supabase
# project (separate from the getupp app's project). Safe to expose
# client-side: the anon key only allows inserts into the `waitlist` table
# under RLS (see supabase-setup.sql).
# PUBLIC_SUPABASE_URL=https://cmedkseoxwijauxptzph.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uDMc5YiqfXT4ydV0Vs8dbg_mN54-KIJ
