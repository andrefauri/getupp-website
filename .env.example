# Safe to expose client-side: the anon key only allows inserts into the
# `waitlist` table under RLS (see supabase-setup.sql).
# PUBLIC_SUPABASE_URL=https://fwheqmwouwfbrgsmwuqe.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=sb_publishable_E38zXUAKvlvucWuT1NSdQQ_KO674qWe
