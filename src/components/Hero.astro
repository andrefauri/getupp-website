---
// redesign-spec-v1.md §4.2. Markup/copy sourced verbatim from div#7a's HERO
// block in design-ref/GET UPP Web - Beast.dc.html, minus the removed Google
// Play badge and the removed 3-step strip (see spec's "REMOVED" notes).
//
// The App Store badge is a <button data-waitlist-trigger="hero"> — clicking
// it opens WaitlistModal.astro (wired in phase 4, see that component).
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 class="hero__headline">GET UP.<br />GET YOUR<br />MORNING BACK.</h1>
        <p class="hero__lead">
          GET UPP blocks your apps until you prove you're out of bed. Then a morning timer
          starts — undistracted time, back on your side.
        </p>
        <div class="hero__badge-row">
          <button type="button" class="hero__badge-btn" data-waitlist-trigger="hero">
            <img src="/images/badges/badge-appstore.png" alt="Download on the App Store" />
          </button>
          <p class="hero__microcopy">FREE TRIAL</p>
        </div>
      </div>

      <div class="hero__phone">
        <div class="hero__phone-screen">
          <div class="hero__phone-status-row hero__phone-status-row--head">
            <span>6.47</span><span>ALARM JUST WENT</span>
          </div>

          <div class="hero__phone-lock">
            <svg
              class="hero__lock-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="4" y="10.5" width="16" height="10.5" rx="1.5"></rect>
              <path d="M8 10.5 V7.5 a4 4 0 0 1 8 0 V10.5"></path>
            </svg>
            <p class="hero__phone-headline">YOUR APPS<br />ARE SHUT.</p>
          </div>

          <div class="hero__phone-status">
            <div class="hero__phone-status-row hero__phone-status-row--rule">
              <span>INSTAGRAM · TIKTOK</span><span>LOCKED</span>
            </div>
            <div class="hero__phone-status-row hero__phone-status-row--rule">
              <span>X · YOUTUBE</span><span>LOCKED</span>
            </div>
            <div class="hero__phone-status-row">
              <span>CALLS · MAPS · MUSIC</span><span>YOURS</span>
            </div>
          </div>

          <div class="hero__phone-cta">
            <div class="hero__phone-button">PROVE YOU'RE UP</div>
            <p class="hero__phone-caption">a selfie outside the bedroom. that's it.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--acid);
    color: var(--ink);
  }

  .hero__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--gap-major);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero__lead {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .hero__badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__badge-btn {
    display: block;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    line-height: 0;
  }

  .hero__badge-btn img {
    display: block;
    height: 58px;
    width: auto;
  }

  .hero__microcopy {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-mono);
  }

  .hero__phone {
    width: 320px;
    aspect-ratio: 320 / 596;
    background: var(--ink);
    border-radius: 40px;
    padding: var(--space-2);
  }

  .hero__phone-screen {
    width: 100%;
    height: 100%;
    background: var(--acid);
    color: var(--ink);
    border-radius: 33px;
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero__phone-status-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--ls-mono);
  }

  .hero__phone-status-row--head {
    flex: 0 0 auto;
  }

  .hero__phone-lock {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__lock-icon {
    width: 42px;
    height: 42px;
  }

  .hero__phone-headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-headline);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero__phone-status {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero__phone-status-row--rule {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding-bottom: var(--space-2);
  }

  .hero__phone-cta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero__phone-button {
    background: var(--ink);
    color: var(--acid);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    text-align: center;
    padding: var(--space-5);
    border-radius: 6px;
  }

  .hero__phone-caption {
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--ls-mono);
  }

  @media (max-width: 767px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__phone {
      width: 280px;
      justify-self: center;
    }
  }
</style>
