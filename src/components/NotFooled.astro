---
// redesign-spec-v1.md §4.5. Markup/copy sourced verbatim from div#7a's
// "PROOF — four frames" block in design-ref/GET UPP Web - Beast.dc.html.
//
// The reference builds its ✕ and ✓ marks from rotated bars/borders rather
// than the Unicode glyphs — neither is in any Anton/Archivo/DM Mono subset,
// so they'd silently fall back to a system font. Reproduced verbatim here
// rather than using literal ✕ / ✓ characters.
//
// Per-tile chip/sticker colours are copied exactly from the reference: the
// REJECTED chip is bone-on-ink's "bone" used as a light accent (not one of
// the two temperatures, but already an established page colour, same as
// the bone card in ThreeScreens) while its sticker is acid-on-ink; APPROVED
// uses ink-on-acid for both. This differs from the spec prose ("REJECTED in
// acid-on-ink") but matches the actual markup, which is the source of truth
// per this build's established precedent.
const tiles = [
  {
    src: '/images/ceiling.png',
    position: 'center',
    verdict: 'rejected',
    sticker: 'LOVELY CEILING.',
  },
  {
    src: '/images/still-in-bedroom.png',
    position: 'center 28%',
    verdict: 'rejected',
    sticker: 'STILL THE BEDROOM. NICE YAWN.',
  },
  {
    src: '/images/look-at-you.png',
    position: 'center 20%',
    verdict: 'approved',
    sticker: 'WELL, LOOK AT YOU.',
  },
  {
    src: '/images/showing-off.png',
    position: 'center 30%',
    verdict: 'approved',
    sticker: "OK, NOW YOU'RE SHOWING OFF.",
  },
] as const;
---

<section class="not-fooled">
  <div class="not-fooled__inner">
    <div class="not-fooled__head">
      <h2 class="not-fooled__headline">IT IS NOT<br />FOOLED BY YOU.</h2>
      <p class="not-fooled__intro">Unlimited goes. The photo never leaves your phone.</p>
    </div>

    <div class="not-fooled__grid">
      {
        tiles.map((tile) => (
          <div
            class="tile"
            style={`background-image: url('${tile.src}'); background-position: ${tile.position};`}
            role="img"
            aria-label={`Mock photo, ${tile.verdict}: ${tile.sticker}`}
          >
            {tile.verdict === 'rejected' ? (
              <div class="tile__chip tile__chip--rejected">
                <span class="tile__mark tile__mark--x" aria-hidden="true">
                  <span />
                  <span />
                </span>
                REJECTED
              </div>
            ) : (
              <div class="tile__chip tile__chip--approved">
                <span class="tile__mark tile__mark--check" aria-hidden="true" />
                APPROVED
              </div>
            )}
            <p class={`tile__sticker tile__sticker--${tile.verdict}`}>{tile.sticker}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .not-fooled {
    background: var(--ink);
    color: var(--bone);
  }

  .not-fooled__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .not-fooled__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .not-fooled__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-section);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--acid);
  }

  .not-fooled__intro {
    margin: 0;
    max-width: 380px;
    font-family: var(--font-body);
    font-size: var(--fs-intro);
    line-height: var(--lh-body);
    color: var(--bone-dim);
  }

  .not-fooled__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-card);
  }

  .tile {
    height: 430px;
    border-radius: 8px;
    overflow: hidden;
    background-size: cover;
    position: relative;
  }

  .tile__chip {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    letter-spacing: var(--ls-mono);
    padding: var(--space-1) var(--space-3);
  }

  .tile__chip--rejected {
    background: var(--bone);
    color: var(--ink);
  }

  .tile__chip--approved {
    background: var(--acid);
    color: var(--ink);
  }

  .tile__mark {
    display: block;
    position: relative;
  }

  .tile__mark--x {
    width: 12px;
    height: 12px;
  }

  .tile__mark--x span {
    position: absolute;
    top: 5px;
    left: 0;
    width: 12px;
    height: 2.5px;
    background: currentColor;
  }

  .tile__mark--x span:first-child {
    transform: rotate(45deg);
  }

  .tile__mark--x span:last-child {
    transform: rotate(-45deg);
  }

  .tile__mark--check {
    width: 13px;
    height: 7px;
    margin-bottom: 3px;
    border-left: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    transform: rotate(-45deg);
  }

  .tile__sticker {
    position: absolute;
    bottom: var(--space-4);
    left: calc(var(--space-2) * -1);
    right: var(--space-3);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    line-height: var(--lh-display);
    padding: var(--space-2) var(--space-3);
    transform: rotate(-2deg);
  }

  .tile__sticker--rejected {
    background: var(--ink);
    color: var(--acid);
  }

  .tile__sticker--approved {
    background: var(--acid);
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .not-fooled__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .not-fooled__intro {
      max-width: none;
    }

    .not-fooled__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Explicit mobile override, not part of the fluid type scale: at
       half-width the longest verdict line only fits at this fixed size. */
    .tile__sticker {
      font-size: 16px;
    }
  }
</style>
