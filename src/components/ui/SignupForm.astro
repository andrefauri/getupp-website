---
export interface Props {
  class?: string;
  /** Recorded on the waitlist row so we can tell which section a signup came from. */
  source?: string;
}

const { class: className = '', source = 'landing' } = Astro.props;
---

<div class={`w-full max-w-sm ${className}`}>
  <form
    data-signup-form
    data-source={source}
    class="flex w-full rounded-2xl border-[1.5px] border-brown bg-cream-light shadow-[0_2px_0_rgba(58,36,24,0.25)]"
  >
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      aria-label="Email address"
      placeholder="name@email.com"
      class="min-w-0 flex-1 bg-transparent px-5 py-4 text-brown placeholder:text-brown/40 focus:outline-none disabled:opacity-60"
    />
    <button
      type="submit"
      class="-m-[1.5px] shrink-0 cursor-pointer rounded-2xl bg-brown px-6 font-display text-lg font-black tracking-wide text-cream-light transition-colors hover:bg-orange disabled:cursor-not-allowed disabled:opacity-70"
    >
      SIGN UP
    </button>
  </form>
  <p data-signup-message role="status" aria-live="polite" class="mt-2 hidden text-sm font-medium"></p>
</div>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function showMessage(el: HTMLElement, text: string, tone: 'success' | 'error') {
    el.textContent = text;
    el.classList.remove('hidden', 'text-brown', 'text-red-600');
    el.classList.add(tone === 'success' ? 'text-brown' : 'text-red-600');
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-signup-form]')) {
    const message = form.parentElement?.querySelector<HTMLElement>('[data-signup-message]');
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const source = form.dataset.source ?? 'landing';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!input || !form.reportValidity()) return;

      const email = input.value.trim().toLowerCase();
      if (!email) return;

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        console.error('Supabase env vars are not configured (PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY).');
        if (message) showMessage(message, 'Something went wrong — try again later.', 'error');
        return;
      }

      input.disabled = true;
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }

      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ email, source }),
        });

        // 201 = inserted. 409 = unique violation (already on the list) — treat as success too.
        if (response.ok || response.status === 409) {
          form.classList.add('hidden');
          if (message) {
            showMessage(
              message,
              response.ok ? "You're on the list! 🎉" : "You're already on the list 🎉",
              'success',
            );
          }
        } else {
          throw new Error(`Unexpected status ${response.status}`);
        }
      } catch (error) {
        console.error('Waitlist signup failed:', error);
        if (message) showMessage(message, 'Something went wrong — try again.', 'error');
        input.disabled = false;
        if (button) {
          button.disabled = false;
          button.textContent = 'SIGN UP';
        }
      }
    });
  }
</script>
