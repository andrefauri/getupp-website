---
import Logo from '../ui/Logo.astro';
---

<footer class="bg-orange">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-10 px-5 py-16 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:py-24"
  >
    <div>
      <Logo />
      <p class="mt-6 text-2xl text-cream-light">Coming soon to iPhone</p>
    </div>

    <div class="flex flex-col gap-2 text-cream-light lg:items-end">
      <a href="/privacy" class="w-fit underline underline-offset-4 hover:opacity-80">
        Privacy Policy
      </a>
      <a
        href="mailto:hello@getupp.co"
        class="w-fit underline underline-offset-4 hover:opacity-80"
      >
        hello@getupp.co
      </a>
      <p class="mt-4 text-sm text-cream-light/80">
        Made by two people who also used to scroll in bed.
      </p>
    </div>
  </div>
</footer>
