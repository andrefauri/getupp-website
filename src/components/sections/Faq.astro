---
const questions = [
  {
    question: 'Will GETUPP block my whole phone?',
    answer:
      'Nope. Just the apps you pick. Your alarm, your maps, your podcast — all fine. Your 7am doomscroll — not so much.',
    open: true,
  },
  {
    question: 'Can I set it to weekdays only?',
    answer:
      'Yep. Pick the days GETUPP shows up for work. Weekdays, weekends, or that one chaotic custom combo only you understand.',
    open: false,
  },
  {
    question: 'What if I get up, then go scroll in the kitchen?',
    answer:
      'We saw that coming. Set a Timeout and your apps stay locked for a bit after you prove you’re up — so "out of bed" actually means out of bed, not relocated.',
    open: false,
  },
  {
    question: 'Do you store my photos?',
    answer:
      'No. Your photo gets checked, then it’s gone — we keep a thumbs-up or thumbs-down and the time, nothing else. No gallery, no cloud, no you-at-7am archive. Ever.',
    open: false,
  },
];
---

<section class="mx-auto max-w-2xl px-5 py-16 sm:px-8 lg:py-24">
  <h2
    class="text-center font-display text-4xl font-black uppercase leading-tight text-brown sm:text-5xl"
  >
    Common Questions
  </h2>

  <div class="mt-10 flex flex-col gap-4">
    {
      questions.map((item) => (
        <details
          open={item.open}
          class="group rounded-xl border-[1.5px] border-brown bg-cream-light px-5 py-4"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-brown [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="size-4 shrink-0 transition-transform group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 5.5 8 11l6-5.5" />
            </svg>
          </summary>
          <p class="mt-3 text-brown/80">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
