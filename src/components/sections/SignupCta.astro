---
import Countdown from '../ui/Countdown.astro';
import SignupForm from '../ui/SignupForm.astro';
---

<section
  class="mx-auto flex max-w-6xl flex-col items-center px-5 py-16 text-center sm:px-8 lg:py-24"
>
  <h2 class="font-display font-black uppercase leading-tight">
    <span class="block text-4xl text-brown sm:text-5xl">
      Your feed will still be there.
    </span>
    <span class="mt-2 block text-2xl text-orange sm:text-3xl">
      Go live a little first.
    </span>
  </h2>

  <div class="mt-8 rounded-2xl bg-cream-light px-6 py-3">
    <Countdown label="Soon on iPhone" />
  </div>

  <SignupForm class="mt-6" source="cta" />
</section>
