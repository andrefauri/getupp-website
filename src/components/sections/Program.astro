---
import { Image } from 'astro:assets';
import lockedPhone from '../../assets/illustrations/locked-phone.png';
import magnifier from '../../assets/illustrations/magnifier.png';
import unlockedPhone from '../../assets/illustrations/unlocked-phone.png';

const steps = [
  {
    number: '01',
    icon: lockedPhone,
    title: 'Wake up',
    copy: 'Your apps are locked. Yes, your favorite social media.',
    band: 'bg-brown',
  },
  {
    number: '02',
    icon: magnifier,
    title: 'Prove it',
    copy: "Take a photo showing you're out of bed.",
    band: 'bg-amber',
  },
  {
    number: '03',
    icon: unlockedPhone,
    title: 'Unlock it',
    copy: 'Get your phone back, streak grows.',
    band: 'bg-orange',
  },
] as const;
---

<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
  <h2
    class="text-center font-display text-4xl font-black uppercase text-brown sm:text-5xl"
  >
    The Program
  </h2>

  <div class="mx-auto mt-10 flex max-w-md flex-col gap-6">
    {
      steps.map((step) => (
        <article class="overflow-hidden rounded-2xl border-[1.5px] border-brown bg-cream-light shadow-[0_2px_0_rgba(58,36,24,0.25)]">
          <div class="flex items-center gap-4 px-6 py-5">
            <span class="font-display text-5xl font-black text-brown">
              {step.number}
            </span>
            <Image src={step.icon} alt="" class="!h-[60px] w-auto shrink-0" />
          </div>
          <div class={`px-6 py-4 ${step.band}`}>
            <h3 class="font-display text-2xl font-black uppercase text-cream-light">
              {step.title}
            </h3>
            <p class="mt-1 text-cream-light/90">{step.copy}</p>
          </div>
        </article>
      ))
    }

    <p class="mt-2 text-brown">
      🔒 Privacy first: your photos get judged by AI for ~2 seconds, then
      deleted. We don't want your bedroom pics, we want you out of bed!
    </p>

    <a
      href="/privacy"
      class="w-fit text-brown underline underline-offset-4 hover:text-orange"
    >
      → Privacy Policy
    </a>
  </div>
</section>
